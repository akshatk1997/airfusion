# AirGuard Environment Configuration Example
# Copy this file to .env and configure your preferences.
# Open-Meteo API works with 0 setup out of the box (free, no key needed).

# Optional Secondary API Keys
OPENWEATHER_API_KEY=
OPENAQ_API_KEY=

# Default App Settings
DEFAULT_CITY=Chandigarh
DEFAULT_LAT=30.7363
DEFAULT_LON=76.7884
DB_PATH=data/airguard.db
CACHE_TTL_SECONDS=900
ALERT_EMAIL_SMTP_HOST=smtp.gmail.com
ALERT_EMAIL_PORT=587
ALERT_EMAIL_USER=
ALERT_EMAIL_PASSWORD=
